{
  "name": "backend",
  "description": "Busket's backend",
  "version": "0.0.0",
  "homepage": "",
  "private": true,
  "keywords": [
    "feathers"
  ],
  "author": {
    "name": "Busch Ilja"
  },
  "contributors": [],
  "bugs": {},
  "engines": {
    "node": ">= 19.8.1"
  },
  "feathers": {
    "language": "ts",
    "packager": "yarn",
    "database": "postgresql",
    "framework": "koa",
    "transports": [
      "rest",
      "websockets"
    ],
    "schema": "typebox"
  },
  "directories": {
    "lib": "src",
    "test": "test"
  },
  "files": [
    "lib/client.js",
    "lib/**/*.d.ts",
    "lib/**/*.shared.js"
  ],
  "main": "lib/client",
  "scripts": {
    "lint": "eslint src/. test/. --config .eslintrc.json --ext .ts --fix",
    "dev": "cross-env NODE_ENV=development node -r @swc-node/register --enable-source-maps --watch src/index.ts",
    "start": "shx rm -rf lib/ && swc src/ -d lib/ && cross-env NODE_ENV=production node --enable-source-maps lib/src/",
    "compile": "shx rm -rf lib/ && tsc --noEmit && swc src/ -d lib/",
    "prettier": "npx prettier \"**/*.ts\" --write",
    "mocha": "cross-env NODE_ENV=test ts-mocha -r tsconfig-paths/register \"test/**/*.ts\" --recursive --exit",
    "test": "cross-env NODE_ENV=test npm run migrate && npm run mocha",
    "bundle:client": "npm run compile && npm pack --pack-destination ./public",
    "migrate": "knex migrate:latest",
    "migrate:make": "knex migrate:make",
    "migrate:list": "knex migrate:list"
  },
  "dependencies": {
    "@feathersjs/adapter-commons": "5.0.48",
    "@feathersjs/authentication": "5.0.48",
    "@feathersjs/authentication-client": "5.0.48",
    "@feathersjs/authentication-local": "5.0.48",
    "@feathersjs/authentication-oauth": "5.0.48",
    "@feathersjs/configuration": "5.0.48",
    "@feathersjs/errors": "5.0.48",
    "@feathersjs/feathers": "5.0.48",
    "@feathersjs/knex": "5.0.48",
    "@feathersjs/koa": "5.0.48",
    "@feathersjs/schema": "5.0.48",
    "@feathersjs/socketio": "5.0.48",
    "@feathersjs/transport-commons": "5.0.48",
    "@feathersjs/typebox": "5.0.48",
    "@koa/multer": "^4.0.0",
    "@types/lodash": "^4.17.25",
    "@types/nodemailer": "^8.0.1",
    "feathers-swagger": "^3.0.0",
    "knex": "^3.3.0",
    "koa-history-api-fallback": "^1.0.0",
    "koa-mount": "^4.2.0",
    "koa-static": "^5.0.0",
    "multer": "2.2.0",
    "nodemailer": "^9.0.5",
    "pg": "8.23.0",
    "sanitize-html": "^2.17.7",
    "swagger-ui-dist": "^5.32.13",
    "vite-plugin-top-level-await": "^1.6.0",
    "winston": "^3.19.0"
  },
  "devDependencies": {
    "@feathersjs/cli": "^5.0.48",
    "@feathersjs/rest-client": "5.0.48",
    "@swc-node/core": "^1.15.0",
    "@swc-node/register": "^1.12.1",
    "@swc/cli": "^0.8.1",
    "@types/mocha": "10.0.10",
    "@types/node": "26.2.0",
    "@types/pg": "^8.21.0",
    "@types/sanitize-html": "^2.16.1",
    "axios": "1.19.0",
    "cross-env": "^10.1.0",
    "mocha": "11.8.0",
    "nodemon": "^3.1.14",
    "prettier": "^3.9.6",
    "shx": "0.4.0",
    "typescript": "~6.0.3"
  },
  "packageManager": "pnpm@10.5.2+sha512.da9dc28cd3ff40d0592188235ab25d3202add8a207afbedc682220e4a0029ffbff4562102b9e6e46b4e3f9e8bd53e6d05de48544b0c57d4b0179e22c76d1199b"
}
