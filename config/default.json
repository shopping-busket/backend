{
  "public": "./public/",
  "origins": [
    "http://localhost:3030"
  ],
  "postgresql": {
    "client": "pg"
  },
  "mailer": {
    "secure": true,
    "name": "Busket"
  },
  "authentication": {
    "entity": "user",
    "service": "users",
    "authStrategies": [
      "jwt",
      "local"
    ],
    "jwtOptions": {
      "header": {
        "typ": "access"
      },
      "audience": "https://yourdomain.com",
      "algorithm": "HS256",
      "expiresIn": "365d"
    },
    "local": {
      "usernameField": "email",
      "passwordField": "password"
    }
  }
}
